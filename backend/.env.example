# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero config). Swap to postgres:// for production.
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ── Auth ──────────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=changeme-in-production
JWT_SECRET=changeme-in-production

# ── Frontend origin ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Temporal ─────────────────────────────────────────────────────────────────
# Local Temporal server: run `temporal server start-dev` in a separate terminal
TEMPORAL_HOST=localhost:7233

# ── Google OAuth (for Gmail Watcher agent) ────────────────────────────────────
# Create a project at https://console.cloud.google.com/
# Enable Gmail API, create OAuth 2.0 credentials (Web application)
# Add http://localhost:8000/auth/google/callback as an authorised redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twitter / X OAuth 2.0 (for X Poster agent) ───────────────────────────────
# Create an app at https://developer.twitter.com/
# Enable OAuth 2.0, set callback URL to http://localhost:8000/auth/twitter/callback
# Required scopes: tweet.read, tweet.write, users.read, offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── File storage ──────────────────────────────────────────────────────────────
FILE_BACKEND=local          # "local" or "s3"
FILE_LOCAL_DIR=/tmp/agent_files

# S3 (only needed if FILE_BACKEND=s3)
# FILE_S3_BUCKET=my-bucket
